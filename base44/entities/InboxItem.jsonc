{
  "name": "InboxItem",
  "type": "object",
  "properties": {
    "message_text": {
      "type": "string",
      "description": "The pasted message body captured for later follow-up"
    },
    "sender_name": {
      "type": "string",
      "description": "Contact name the message came from (manual entry, optional)"
    },
    "sender_number": {
      "type": "string",
      "description": "Phone number the message came from (manual entry, optional)"
    },
    "organization_entity": {
      "type": "string",
      "description": "Organizational entity level selected for this captured message (e.g. General Conference, Division, Union, Conference, Church, School, Ministry), or 'None'."
    },
    "entity_type": {
      "type": "string",
      "enum": [
        "Task",
        "Engagement",
        "Trip",
        "None"
      ],
      "default": "None",
      "description": "Which category this captured message relates to, chosen at capture time. 'None' means uncategorized."
    },
    "message_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date/time the message was received"
    },
    "reminder_at": {
      "type": "string",
      "format": "date-time",
      "description": "Optional date/time to resurface this item as due. When it passes, the reminder engine flags the item and posts a notification to the bell."
    },
    "reminder_fired": {
      "type": "boolean",
      "default": false,
      "description": "True once the reminder_at notification has been fired by the reminder engine, to prevent duplicate notifications. Written only by the checkInboxReminders backend function (service role)."
    }
  },
  "required": [
    "message_text"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}