{
  "name": "InboxItem",
  "type": "object",
  "properties": {
    "message_text": {
      "type": "string",
      "description": "The pasted message body captured for later follow-up, or the source title for an important-flag record."
    },
    "sender_name": {
      "type": "string",
      "description": "Contact name the message came from (manual entry, optional)"
    },
    "sender_number": {
      "type": "string",
      "description": "Phone number the message came from (manual entry, optional)"
    },
    "organization_entity": {
      "type": "string",
      "description": "Organizational entity level selected for this captured message, or 'None'."
    },
    "entity_type": {
      "type": "string",
      "enum": [
        "Task",
        "Engagement",
        "Trip",
        "None"
      ],
      "default": "None",
      "description": "Which category this captured message relates to. 'None' means uncategorized."
    },
    "message_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date/time the message was received, or the source record's date for an important-flag item."
    },
    "reminder_at": {
      "type": "string",
      "format": "date-time",
      "description": "Optional date/time to resurface this item as due."
    },
    "reminder_fired": {
      "type": "boolean",
      "default": false,
      "description": "True once the reminder_at notification has been fired, to prevent duplicates."
    },
    "is_important": {
      "type": "boolean",
      "default": false,
      "description": "True when this record flags a source record as important for the Inbox."
    },
    "source_type": {
      "type": "string",
      "enum": [
        "Engagement",
        "Trip",
        "CalendarEvent",
        "Task",
        "Fitness",
        "DailyReflection",
        "None"
      ],
      "default": "None",
      "description": "The kind of source record this important flag points at."
    },
    "source_id": {
      "type": "string",
      "description": "ID of the source record this flag references."
    },
    "source_title": {
      "type": "string",
      "description": "Cached display title of the source record."
    },
    "workspace_id": {
      "type": "string",
      "description": "Workspace this inbox item belongs to. Stamped server-side by the data backend function."
    }
  },
  "required": [
    "message_text"
  ],
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  }
}