{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "is_owner": {
      "type": "boolean",
      "default": false,
      "description": "True for the single app Owner. The Owner is a super-administrator: they always have full access and are the only user who can manage access roles in User Management."
    },
    "can_comment": {
      "type": "boolean",
      "description": "Explicit per-user override for commenting in engagement and plan discussions. true forces on, false forces off; when unset the role default applies."
    },
    "can_be_assigned": {
      "type": "boolean",
      "description": "Explicit per-user override for being assigned to work plans. true forces on, false forces off; when unset the role default applies."
    },
    "can_create_personal_plans": {
      "type": "boolean",
      "description": "Explicit per-user override for creating personal (family) calendar plans. true forces on, false forces off; when unset the role default applies."
    },
    "can_create_work_plans": {
      "type": "boolean",
      "description": "Explicit per-user override for creating work (coworker) calendar plans. true forces on, false forces off; when unset the role default applies."
    },
    "can_start_chats": {
      "type": "boolean",
      "description": "Explicit per-user override for starting chat conversations (creating a ChatRoom). true forces on, false forces off; when unset the role default from AppSettings applies. Users without this permission may still be added to, and reply within, conversations that others start."
    }
  },
  "required": [
    "role"
  ]
}