{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "is_owner": {
      "type": "boolean",
      "default": false,
      "description": "True for the single app Owner. The Owner is a super-administrator: they always have full access and are the only user who can manage access roles in User Management."
    },
    "can_comment": {
      "type": "boolean",
      "default": false,
      "description": "Allows this user to participate in internal engagement and plan discussions. Administrators always can."
    },
    "can_be_assigned": {
      "type": "boolean",
      "default": false,
      "description": "Allows this user to be assigned to work plans. Administrators always can."
    },
    "can_create_personal_plans": {
      "type": "boolean",
      "default": false,
      "description": "Per-user grant letting this administrator create personal (family) calendar plans. Active when the role default is off and this flag is on."
    },
    "can_create_work_plans": {
      "type": "boolean",
      "default": false,
      "description": "Per-user grant letting this administrator create work (coworker) calendar plans. Active when the role default is off and this flag is on."
    }
  },
  "required": [
    "role"
  ]
}