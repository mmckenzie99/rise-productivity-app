{
  "name": "ChatRoom",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Display name for the conversation (other user's name for direct, item name for linked rooms)"
    },
    "topic": {
      "type": "string",
      "description": "Optional short topic/subject for the thread, used to describe its purpose and aid search"
    },
    "type": {
      "type": "string",
      "enum": [
        "direct",
        "engagement",
        "trip",
        "plan"
      ],
      "default": "direct",
      "description": "Whether this is a direct message or a thread linked to an engagement, trip, or plan"
    },
    "participant_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "User ids of all participants in the room"
    },
    "participant_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Cached display names of participants, parallel to participant_ids"
    },
    "linked_id": {
      "type": "string",
      "description": "ID of the linked engagement, trip, or plan (when type is engagement, trip, or plan)"
    },
    "linked_title": {
      "type": "string",
      "description": "Cached title of the linked engagement, trip, or plan for display"
    },
    "last_message": {
      "type": "string",
      "description": "Preview snippet of the most recent message"
    },
    "last_message_at": {
      "type": "string",
      "description": "ISO timestamp of the most recent message, used for sorting rooms"
    },
    "last_sender_name": {
      "type": "string",
      "description": "Cached display name of the most recent sender"
    },
    "archived": {
      "type": "boolean",
      "default": false,
      "description": "DEPRECATED \u2014 legacy room-level archive flag, retained only for the migration window. Per-person archiving now uses archived_by. The migrateChatArchives function copies archived=true into archived_by; once verified, this field is unset in a follow-up cleanup."
    },
    "archived_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "User ids of participants who have archived this conversation for themselves. A room appears in a user's Archived tab only when their id is present here, and in their Conversations tab when it is absent \u2014 so archiving is independent per person. Written only by the toggleChatArchive backend function (service role); never by a client ChatRoom.update."
    }
  },
  "required": [
    "title",
    "type",
    "participant_ids"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.participant_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "no_direct_create"
      }
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.participant_ids": {
            "$in": [
              "{{user.id}}"
            ]
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}