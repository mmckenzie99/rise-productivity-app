{
  "name": "Notification",
  "type": "object",
  "properties": {
    "engagement_id": {
      "type": "string",
      "description": "ID of the linked entity. For engagement reminders this is the engagement id; for chat-message notifications this is the ChatRoom id (used by the recipient's app to find and clear them on open)."
    },
    "engagement_title": {
      "type": "string",
      "description": "Cached title for display (engagement title, reminder label, or 'Sender in Room' for chat messages)"
    },
    "speaking_date": {
      "type": "string",
      "format": "date"
    },
    "speaking_time": {
      "type": "string"
    },
    "timezone": {
      "type": "string"
    },
    "window_label": {
      "type": "string",
      "description": "Which reminder window triggered this (e.g. 14 Days, 15 Minutes, Meditation, Goal) or 'New Message' for chat-message notifications"
    },
    "recipient_id": {
      "type": "string",
      "description": "User id this notification is addressed to. Set for targeted notifications (e.g. chat messages) so only the recipient sees them in their bell and can mark them read. Omitted for broadcast reminders, which remain visible to all authenticated users as before."
    },
    "email_sent": {
      "type": "boolean",
      "default": false
    },
    "read": {
      "type": "boolean",
      "default": false
    },
    "dismissed": {
      "type": "boolean",
      "default": false,
      "description": "True when the user dismissed the notification. Dismissed records are kept (not deleted) so the reminder engine still sees the window as already fired and won't recreate it; the bell hides them from the list."
    }
  },
  "required": [
    "window_label"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.recipient_id": "{{user.id}}"
        },
        {
          "data.recipient_id": null
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.recipient_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}