{
  "name": "Notification",
  "type": "object",
  "properties": {
    "engagement_id": {
      "type": "string",
      "description": "ID of the linked entity (engagement id, CalendarEvent/plan id, or ChatRoom id for message notifications)."
    },
    "engagement_title": {
      "type": "string",
      "description": "Cached title for display"
    },
    "speaking_date": {
      "type": "string",
      "format": "date"
    },
    "speaking_time": {
      "type": "string"
    },
    "timezone": {
      "type": "string"
    },
    "window_label": {
      "type": "string",
      "description": "Which reminder window triggered this (e.g. 14 Days, 15 Minutes) or 'New Message' / 'Assigned to you' / 'Completed'."
    },
    "recipient_id": {
      "type": "string",
      "description": "Reserved. In the shared-workspace model notifications are workspace-wide, so this is typically omitted."
    },
    "email_sent": {
      "type": "boolean",
      "default": false
    },
    "read": {
      "type": "boolean",
      "default": false
    },
    "dismissed": {
      "type": "boolean",
      "default": false,
      "description": "True when dismissed. Kept (not deleted) so the reminder engine won't recreate it; the bell hides dismissed items."
    },
    "workspace_id": {
      "type": "string",
      "description": "Workspace this notification belongs to. Stamped server-side by the data backend function."
    }
  },
  "required": [
    "window_label"
  ],
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  }
}