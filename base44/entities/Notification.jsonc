{
  "name": "Notification",
  "type": "object",
  "properties": {
    "engagement_id": {
      "type": "string",
      "description": "ID of the linked engagement"
    },
    "engagement_title": {
      "type": "string",
      "description": "Cached engagement title for display"
    },
    "speaking_date": {
      "type": "string",
      "format": "date"
    },
    "speaking_time": {
      "type": "string"
    },
    "timezone": {
      "type": "string"
    },
    "window_label": {
      "type": "string",
      "description": "Which reminder window triggered this (e.g. 14 Days, 15 Minutes)"
    },
    "email_sent": {
      "type": "boolean",
      "default": false
    },
    "read": {
      "type": "boolean",
      "default": false
    },
    "dismissed": {
      "type": "boolean",
      "default": false,
      "description": "True when the user dismissed the notification. Dismissed records are kept (not deleted) so the reminder engine still sees the window as already fired and won't recreate it; the bell hides them from the list."
    }
  },
  "required": [
    "engagement_id",
    "engagement_title",
    "window_label"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}