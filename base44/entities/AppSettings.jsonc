{
  "name": "AppSettings",
  "type": "object",
  "properties": {
    "features": {
      "type": "object",
      "description": "Role-based feature access defaults. Each feature key maps a role ('admin' or 'user') to a boolean. Most features auto-grant admins full access; the plan-creation flags (can_create_personal_plans, can_create_work_plans) are evaluated per role without an admin bypass, so an admin role default of false actually restricts that admin group. The dashboard_sections key maps each Dashboard section id to a per-role visibility boolean (Owner always sees every section).",
      "properties": {
        "can_comment": {
          "type": "object",
          "properties": {
            "admin": {
              "type": "boolean"
            },
            "user": {
              "type": "boolean"
            }
          }
        },
        "can_be_assigned": {
          "type": "object",
          "properties": {
            "admin": {
              "type": "boolean"
            },
            "user": {
              "type": "boolean"
            }
          }
        },
        "can_create_personal_plans": {
          "type": "object",
          "properties": {
            "admin": {
              "type": "boolean"
            },
            "user": {
              "type": "boolean"
            }
          }
        },
        "can_create_work_plans": {
          "type": "object",
          "properties": {
            "admin": {
              "type": "boolean"
            },
            "user": {
              "type": "boolean"
            }
          }
        },
        "can_start_chats": {
          "type": "object",
          "description": "Default per role for starting chat conversations. Owner always bypasses; an explicit per-user can_start_chats override on the User record wins over this default.",
          "properties": {
            "admin": {
              "type": "boolean"
            },
            "user": {
              "type": "boolean"
            }
          }
        },
        "can_view_reflections": {
          "type": "object",
          "description": "Default per role for using the daily meditation / reflection feature. Owner always bypasses; an explicit per-user can_view_reflections override on the User record wins over this default. Oversight of others' reflections is always Owner-only and is not controlled by this flag.",
          "properties": {
            "admin": {
              "type": "boolean"
            },
            "user": {
              "type": "boolean"
            }
          }
        },
        "dashboard_sections": {
          "type": "object",
          "description": "Per-role visibility for each Dashboard section. Missing keys default to visible (true).",
          "properties": {
            "stat_cards": {
              "type": "object",
              "properties": {
                "admin": {
                  "type": "boolean"
                },
                "user": {
                  "type": "boolean"
                }
              }
            },
            "plans": {
              "type": "object",
              "properties": {
                "admin": {
                  "type": "boolean"
                },
                "user": {
                  "type": "boolean"
                }
              }
            },
            "status_chart": {
              "type": "object",
              "properties": {
                "admin": {
                  "type": "boolean"
                },
                "user": {
                  "type": "boolean"
                }
              }
            },
            "category_chart": {
              "type": "object",
              "properties": {
                "admin": {
                  "type": "boolean"
                },
                "user": {
                  "type": "boolean"
                }
              }
            },
            "monthly_chart": {
              "type": "object",
              "properties": {
                "admin": {
                  "type": "boolean"
                },
                "user": {
                  "type": "boolean"
                }
              }
            },
            "weekly_goals": {
              "type": "object",
              "properties": {
                "admin": {
                  "type": "boolean"
                },
                "user": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "features"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}