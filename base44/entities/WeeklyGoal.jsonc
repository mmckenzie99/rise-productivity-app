{
  "name": "WeeklyGoal",
  "type": "object",
  "properties": {
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "The Sunday (week start) date this goal belongs to"
    },
    "goals": {
      "type": "array",
      "description": "Structured list of weekly goals, each with its own focus category",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for this goal item"
          },
          "text": {
            "type": "string",
            "description": "The goal text"
          },
          "focus": {
            "type": "string",
            "description": "Focus category (e.g. Spiritual, Professional, Physical)"
          },
          "completed": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "goal_reminder_time": {
      "type": "string",
      "description": "Time of day (HH:MM) to send a weekly goal review reminder on the week's start date, or blank for none"
    },
    "reminder_timezone": {
      "type": "string",
      "description": "IANA timezone the reminder time is interpreted in (e.g. America/Detroit)"
    }
  },
  "required": [
    "start_date"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}