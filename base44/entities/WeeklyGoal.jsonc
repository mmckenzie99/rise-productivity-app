{
  "name": "WeeklyGoal",
  "type": "object",
  "properties": {
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "The Sunday (week start) date this goal belongs to"
    },
    "goals": {
      "type": "array",
      "description": "Structured list of weekly goals, each with one or more focus categories and an optional daily reminder time",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for this goal item"
          },
          "text": {
            "type": "string",
            "description": "The goal text"
          },
          "focus": {
            "type": "array",
            "description": "Focus categories (e.g. Spiritual, Professional, Physical)",
            "items": {
              "type": "string"
            }
          },
          "completed": {
            "type": "boolean",
            "default": false
          },
          "reminder_time": {
            "type": "string",
            "description": "Time of day (HH:MM) for a daily reminder, or blank for none"
          }
        }
      }
    },
    "goal_reminder_time": {
      "type": "string",
      "description": "Time of day (HH:MM) for a weekly review reminder, or blank for none"
    },
    "reminder_timezone": {
      "type": "string",
      "description": "IANA timezone the reminder time is interpreted in"
    },
    "workspace_id": {
      "type": "string",
      "description": "Workspace this weekly goal set belongs to. Shared between workspace members. Stamped server-side by the data backend function."
    }
  },
  "required": [
    "start_date"
  ],
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  }
}