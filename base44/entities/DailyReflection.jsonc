{
  "name": "DailyReflection",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "description": "The day this reflection belongs to"
    },
    "goals": {
      "type": "string",
      "description": "Goals for the day (oversight field)"
    },
    "meditation": {
      "type": "string",
      "description": "Bible verse or Spirit of Prophecy statement to meditate on (oversight field)"
    },
    "meditation_reference": {
      "type": "string",
      "description": "Reference or source for the meditation text (oversight field)"
    },
    "note": {
      "type": "string",
      "description": "Rich-text note with formatting (oversight field)"
    },
    "meditation_reminder_time": {
      "type": "string",
      "description": "Time of day (HH:MM) to send a meditation reminder, or blank for none (oversight field)"
    },
    "reminder_timezone": {
      "type": "string",
      "description": "IANA timezone the reminder time is interpreted in (oversight field)"
    },
    "last_viewed_by_admin_id": {
      "type": "string",
      "description": "User id of the admin who last reviewed this reflection for oversight (stamped by recordReflectionView)"
    },
    "last_viewed_by_admin_name": {
      "type": "string",
      "description": "Name of the admin who last reviewed this reflection for oversight (stamped by recordReflectionView)"
    },
    "last_viewed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of the last oversight review (stamped by recordReflectionView)"
    },
    "workspace_id": {
      "type": "string",
      "description": "Workspace this reflection belongs to. Stamped server-side by the data backend function."
    }
  },
  "required": [
    "date"
  ],
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  }
}