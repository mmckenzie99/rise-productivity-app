{
  "name": "DailyReflection",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "description": "The day this reflection belongs to"
    },
    "goals": {
      "type": "string",
      "description": "Goals for the day"
    },
    "meditation": {
      "type": "string",
      "description": "Bible verse or Spirit of Prophecy statement to meditate on"
    },
    "meditation_reference": {
      "type": "string",
      "description": "Reference or source for the meditation text"
    },
    "note": {
      "type": "string",
      "description": "Rich-text note with formatting"
    },
    "linked_engagement_id": {
      "type": "string",
      "description": "ID of the engagement this reflection note is linked to for syncing"
    },
    "meditation_reminder_time": {
      "type": "string",
      "description": "Time of day (HH:MM) to send a meditation reminder, or blank for none"
    },
    "reminder_timezone": {
      "type": "string",
      "description": "IANA timezone the reminder time is interpreted in"
    },
    "workspace_id": {
      "type": "string",
      "description": "Workspace this reflection belongs to. Shared between workspace members. Stamped server-side by the data backend function."
    }
  },
  "required": [
    "date"
  ],
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  }
}