{
  "name": "Trip",
  "type": "object",
  "properties": {
    "place": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Place(s) this trip covers"
    },
    "department": {
      "type": "string",
      "enum": [
        "Expense to Thrive",
        "Expense to Engage",
        "Expense Local Entity"
      ]
    },
    "leave_date": {
      "type": "string",
      "format": "date"
    },
    "leave_time": {
      "type": "string"
    },
    "return_date": {
      "type": "string",
      "format": "date"
    },
    "return_time": {
      "type": "string"
    },
    "departure_airport": {
      "type": "string"
    },
    "rental_pickup_location": {
      "type": "string"
    },
    "travel_entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "Flight",
              "Rental",
              "Gas/Fuel",
              "Personal Auto"
            ]
          },
          "description": {
            "type": "string"
          },
          "airline": {
            "type": "string"
          },
          "departure_airport": {
            "type": "string"
          },
          "arrival_airport": {
            "type": "string"
          },
          "rental_company": {
            "type": "string"
          },
          "rental_pickup_location": {
            "type": "string"
          },
          "dropoff_location": {
            "type": "string"
          },
          "cost": {
            "type": "number"
          },
          "receipt": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "lodging_entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "check_in_date": {
            "type": "string",
            "format": "date"
          },
          "check_out_date": {
            "type": "string",
            "format": "date"
          },
          "cost": {
            "type": "number"
          },
          "receipt": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "per_diem_days": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "type": {
            "type": "string",
            "enum": [
              "Full Day",
              "Half Day"
            ]
          },
          "amount": {
            "type": "number"
          }
        }
      }
    },
    "expense_report": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      }
    },
    "total_per_diem": {
      "type": "number"
    },
    "total_cost": {
      "type": "number"
    },
    "workspace_id": {
      "type": "string",
      "description": "Workspace this trip belongs to. Stamped server-side by the data backend function."
    }
  },
  "required": [
    "place",
    "department"
  ],
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  }
}