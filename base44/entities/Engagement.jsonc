{
  "name": "Engagement",
  "type": "object",
  "properties": {
    "place": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "presentation_description": {
      "type": "string",
      "description": "Description specific to a presentation title (only for Presentation(s) type)"
    },
    "presentation_type": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Presentation(s)",
          "Workshop",
          "Training",
          "Booth",
          "Vision-Casting"
        ]
      }
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Creation start date (preparation timeline for presentations)"
    },
    "deploy_date": {
      "type": "string",
      "format": "date",
      "description": "Deploy date (preparation timeline for presentations)"
    },
    "speaking_date": {
      "type": "string",
      "format": "date",
      "description": "Engagement date (start of range if multi-day)"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "End date for multi-day engagement ranges"
    },
    "start_time": {
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "timezone": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Planning",
        "Confirmed",
        "Completed"
      ],
      "default": "Planning"
    },
    "progress": {
      "type": "string",
      "enum": [
        "Not Started",
        "In Progress",
        "Ready to Deploy",
        "Deploying"
      ],
      "default": "Not Started"
    },
    "speaker_name": {
      "type": "string"
    },
    "speaker_bio": {
      "type": "string"
    },
    "speaker_photo": {
      "type": "string"
    },
    "presentation_file_url": {
      "type": "string",
      "description": "Link to the presentation file"
    },
    "handout_url": {
      "type": "string",
      "description": "Link to the presentation handout"
    },
    "address": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          }
        }
      }
    },
    "workspace_id": {
      "type": "string",
      "description": "Workspace this engagement belongs to. Stamped server-side by the data backend function; scopes all access to the owning workspace."
    }
  },
  "required": [
    "speaker_name"
  ],
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  }
}