{
  "name": "CalendarEvent",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "What the plan/item is"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "The day this plan is scheduled"
    },
    "all_day": {
      "type": "boolean",
      "default": true,
      "description": "Whether this plan spans the whole day rather than a specific time"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Optional end date for a multi-day all-day plan; blank means single day"
    },
    "start_time": {
      "type": "string",
      "description": "Start time (HH:MM, 24h)"
    },
    "end_time": {
      "type": "string",
      "description": "End time (HH:MM, 24h)"
    },
    "category": {
      "type": "string",
      "enum": [
        "Personal",
        "Work"
      ],
      "default": "Personal"
    },
    "assignee_id": {
      "type": "string",
      "description": "User id of the administrator this work plan is assigned to"
    },
    "assignee_name": {
      "type": "string",
      "description": "Cached display name of the assignee"
    },
    "completed": {
      "type": "boolean",
      "default": false
    },
    "completed_date": {
      "type": "string",
      "format": "date",
      "description": "When the plan was marked complete"
    },
    "notes": {
      "type": "string",
      "description": "Optional details about the plan"
    }
  },
  "required": [
    "title",
    "date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.assignee_id": "{{user.id}}"
        }
      ]
    },
    "create": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.assignee_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}