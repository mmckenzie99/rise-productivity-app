{
  "name": "Comment",
  "type": "object",
  "properties": {
    "engagement_id": {
      "type": "string",
      "description": "ID of the engagement this comment belongs to"
    },
    "body": {
      "type": "string",
      "description": "Comment text"
    },
    "author_name": {
      "type": "string",
      "description": "Cached display name of the comment author"
    }
  },
  "required": [
    "engagement_id",
    "body"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}