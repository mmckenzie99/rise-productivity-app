{
  "name": "Comment",
  "type": "object",
  "properties": {
    "engagement_id": {
      "type": "string",
      "description": "ID of the engagement this comment belongs to"
    },
    "body": {
      "type": "string",
      "description": "Comment text"
    },
    "author_name": {
      "type": "string",
      "description": "Cached display name of the comment author"
    },
    "workspace_id": {
      "type": "string",
      "description": "Workspace this comment belongs to. Stamped server-side by the data backend function."
    }
  },
  "required": [
    "engagement_id",
    "body"
  ],
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  }
}