{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "room_id": {
      "type": "string",
      "description": "ID of the ChatRoom this message belongs to"
    },
    "body": {
      "type": "string",
      "description": "Message text"
    },
    "attachment": {
      "type": "object",
      "description": "Optional file shared in the message",
      "properties": {
        "name": {
          "type": "string",
          "description": "Original file name"
        },
        "url": {
          "type": "string",
          "description": "Public URL of the uploaded file"
        }
      }
    },
    "author_id": {
      "type": "string",
      "description": "User id of the sender"
    },
    "author_name": {
      "type": "string",
      "description": "Cached display name of the sender"
    },
    "participant_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Snapshot of the room's participant ids at send time, used to gate read access"
    }
  },
  "required": [
    "room_id",
    "body"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.participant_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}