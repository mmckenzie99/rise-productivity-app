{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "engagement_reminder_check",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "reminders": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "checkEngagementReminders",
            "args": {
              "secret": "9f3a2b7e8c1d4a6f0b5e3c2d1a9f8e7b"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Every 5 minutes, checks engagements for due reminders (deploy date and countdown windows) and sends in-app + email notifications. Invokes checkEngagementReminders with the cron secret so anonymous direct HTTP calls are rejected.",
  "name": "Engagement Reminder Check"
}